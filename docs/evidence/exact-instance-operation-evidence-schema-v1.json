{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatpad-super-driver.invalid/schemas/exact-instance-operation-evidence-v1.json",
  "title": "Chatpad exact-instance offline operation evidence",
  "type": "object",
  "required": [
    "schema_id", "canonical_json_version", "producer", "evidence_mode", "operation_id", "plan_sha256",
    "implementation_commit", "adapter_identity", "adapter_mode", "synthetic", "source_classification",
    "target_instance_id", "preconditions", "state_transitions", "adapter_calls", "before_driver_identity",
    "after_driver_identity", "restart_required", "reboot_required", "mutation_attempt_count",
    "synthetic_exact_binding_attempt_count", "synthetic_exact_successful_binding_count",
    "synthetic_exact_restoration_attempt_count", "synthetic_exact_successful_restoration_count",
    "synthetic_restart_attempt_count", "live_exact_binding_operation_count",
    "live_exact_restoration_operation_count", "live_restart_operation_count",
    "broad_installation_attempt_count", "broad_rollback_attempt_count", "live_operation_count",
    "windows_mutation_count", "controlled_failure_count", "uncontrolled_exception_count", "exception_type",
    "verification_result", "result_code", "stop_condition", "restoration_outcome", "restoration_identity",
    "mutation_may_have_occurred", "uncertainty_status",
    "final_classification", "live_readiness_satisfied", "readiness", "current_gate", "capability_blocker"
  ],
  "properties": {
    "schema_id": { "const": "chatpad-exact-instance-operation-evidence-v1" },
    "canonical_json_version": { "const": "chatpad-canonical-json-v1" },
    "producer": { "const": "tools/ExactInstance/ChatpadExactInstance.Orchestrator.psm1" },
    "evidence_mode": { "const": "offline-synthetic" },
    "operation_id": { "type": "string", "format": "uuid" },
    "plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "implementation_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "adapter_identity": { "const": "chatpad-fake-exact-instance-adapter-v1" },
    "adapter_mode": { "const": "offline-fake" },
    "synthetic": { "const": true },
    "source_classification": { "const": "synthetic" },
    "target_instance_id": { "type": "string", "minLength": 5 },
    "preconditions": { "type": "object" },
    "state_transitions": { "type": "array", "minItems": 1 },
    "adapter_calls": { "type": "array" },
    "before_driver_identity": { "type": ["object", "null"] },
    "after_driver_identity": { "type": ["object", "null"] },
    "restart_required": { "type": "boolean" },
    "reboot_required": { "type": "boolean" },
    "mutation_attempt_count": { "$ref": "#/$defs/count" },
    "synthetic_exact_binding_attempt_count": { "$ref": "#/$defs/count" },
    "synthetic_exact_successful_binding_count": { "$ref": "#/$defs/count" },
    "synthetic_exact_restoration_attempt_count": { "$ref": "#/$defs/count" },
    "synthetic_exact_successful_restoration_count": { "$ref": "#/$defs/count" },
    "synthetic_restart_attempt_count": { "$ref": "#/$defs/count" },
    "live_exact_binding_operation_count": { "const": 0 },
    "live_exact_restoration_operation_count": { "const": 0 },
    "live_restart_operation_count": { "const": 0 },
    "broad_installation_attempt_count": { "$ref": "#/$defs/count" },
    "broad_rollback_attempt_count": { "$ref": "#/$defs/count" },
    "live_operation_count": { "const": 0 },
    "windows_mutation_count": { "const": 0 },
    "controlled_failure_count": { "$ref": "#/$defs/count" },
    "uncontrolled_exception_count": { "$ref": "#/$defs/count" },
    "exception_type": { "type": "string" },
    "verification_result": { "enum": ["PASS", "BLOCKED", "FAIL"] },
    "result_code": { "type": "string", "minLength": 1 },
    "stop_condition": { "type": "string" },
    "restoration_outcome": { "type": "string", "minLength": 1 },
    "restoration_identity": { "type": "object" },
    "mutation_may_have_occurred": { "type": "boolean" },
    "uncertainty_status": { "enum": ["none", "active", "recovered"] },
    "final_classification": { "enum": ["PASS", "BLOCKED", "FAIL"] },
    "live_readiness_satisfied": { "const": false },
    "readiness": { "const": "BLOCKED" },
    "current_gate": { "const": "BLOCKED_PENDING_INDEPENDENT_NATIVE_ADAPTER_SCAFFOLD_REAUDIT" },
    "capability_blocker": { "const": "BLOCKED_NATIVE_ADAPTER_EXECUTION_NOT_IMPLEMENTED" }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
