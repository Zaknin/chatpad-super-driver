{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatpad-super-driver.invalid/schemas/exact-instance-operation-evidence-v1.json",
  "title": "Chatpad exact-instance operation evidence",
  "type": "object",
  "required": [
    "schema_id",
    "operation_id",
    "plan_sha256",
    "implementation_commit",
    "adapter_identity",
    "adapter_mode",
    "synthetic",
    "source_classification",
    "target_instance_id",
    "state_transitions",
    "adapter_calls",
    "mutation_attempt_count",
    "live_exact_binding_operation_count",
    "live_exact_restoration_operation_count",
    "live_restart_operation_count",
    "broad_installation_attempt_count",
    "broad_rollback_attempt_count",
    "windows_mutation_count",
    "uncontrolled_exception_count",
    "final_classification",
    "live_readiness_satisfied",
    "blocker"
  ],
  "properties": {
    "schema_id": { "const": "chatpad-exact-instance-operation-evidence-v1" },
    "operation_id": { "type": "string", "format": "uuid" },
    "plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "implementation_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "adapter_identity": { "type": "string", "minLength": 1 },
    "adapter_mode": { "enum": ["offline-fake", "windows-exact-instance"] },
    "synthetic": { "type": "boolean" },
    "source_classification": { "enum": ["synthetic", "live"] },
    "target_instance_id": { "type": "string", "minLength": 5 },
    "state_transitions": { "type": "array", "minItems": 1 },
    "adapter_calls": { "type": "array" },
    "mutation_attempt_count": { "type": "integer", "minimum": 0 },
    "live_exact_binding_operation_count": { "type": "integer", "minimum": 0 },
    "live_exact_restoration_operation_count": { "type": "integer", "minimum": 0 },
    "live_restart_operation_count": { "type": "integer", "minimum": 0 },
    "broad_installation_attempt_count": { "type": "integer", "minimum": 0 },
    "broad_rollback_attempt_count": { "type": "integer", "minimum": 0 },
    "windows_mutation_count": { "type": "integer", "minimum": 0 },
    "uncontrolled_exception_count": { "type": "integer", "minimum": 0 },
    "final_classification": { "enum": ["PASS", "BLOCKED", "FAIL"] },
    "live_readiness_satisfied": { "const": false },
    "blocker": { "const": "BLOCKED_PENDING_INDEPENDENT_AUDIT" }
  },
  "additionalProperties": true
}
