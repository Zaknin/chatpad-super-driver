{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatpad-super-driver.invalid/schemas/exact-instance-operation-plan-v1.json",
  "title": "Chatpad exact-instance operation plan",
  "type": "object",
  "required": [
    "schema_id", "schema_version", "canonical_json_version", "operation_id", "operation_type",
    "generated_utc", "expires_utc", "repository_branch", "implementation_commit", "host_identity",
    "session_identity", "authorization_context", "requested_instance_id", "canonical_instance_id",
    "device_class_guid", "container_id", "parent_instance_id", "location_paths", "hardware_ids",
    "compatible_ids", "current_device_status", "current_problem_code", "current_driver_identity",
    "target_package_path", "target_package_byte_size", "target_package_sha256", "target_driver_identity",
    "expected_post_bind_driver_identity", "restoration_snapshot", "exact_restoration_driver_identity",
    "precondition_fingerprint", "restoration_snapshot_fingerprint", "authorized_actions",
    "expected_restart_reboot_policy", "stop_conditions", "plan_sha256"
  ],
  "properties": {
    "schema_id": { "const": "chatpad-exact-instance-operation-plan-v1" },
    "schema_version": { "const": 1 },
    "canonical_json_version": { "const": "chatpad-canonical-json-v1" },
    "operation_id": { "type": "string", "format": "uuid" },
    "operation_type": { "enum": ["bind", "restore"] },
    "generated_utc": { "type": "string", "format": "date-time" },
    "expires_utc": { "type": "string", "format": "date-time" },
    "repository_branch": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._/-]+$" },
    "implementation_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "host_identity": { "type": "string", "minLength": 1 },
    "session_identity": { "type": "string", "minLength": 1 },
    "authorization_context": {
      "type": "object",
      "required": ["source", "synthetic"],
      "properties": {
        "source": { "const": "offline-synthetic-suite" },
        "synthetic": { "const": true }
      },
      "additionalProperties": false
    },
    "requested_instance_id": { "$ref": "#/$defs/instanceId" },
    "canonical_instance_id": { "$ref": "#/$defs/instanceId" },
    "device_class_guid": { "type": "string", "format": "uuid" },
    "container_id": { "type": "string" },
    "parent_instance_id": { "type": "string" },
    "location_paths": { "$ref": "#/$defs/stringArray" },
    "hardware_ids": { "$ref": "#/$defs/stringArray" },
    "compatible_ids": { "$ref": "#/$defs/stringArray" },
    "current_device_status": { "type": "string", "minLength": 1 },
    "current_problem_code": { "type": "integer", "minimum": 0 },
    "current_driver_identity": { "$ref": "#/$defs/driverIdentity" },
    "target_package_path": { "type": "string", "minLength": 3 },
    "target_package_byte_size": { "type": "integer", "minimum": 1 },
    "target_package_sha256": { "$ref": "#/$defs/sha256" },
    "target_driver_identity": { "$ref": "#/$defs/driverIdentity" },
    "expected_post_bind_driver_identity": { "$ref": "#/$defs/driverIdentity" },
    "restoration_snapshot": { "$ref": "#/$defs/restorationSnapshot" },
    "exact_restoration_driver_identity": { "$ref": "#/$defs/driverIdentity" },
    "precondition_fingerprint": { "$ref": "#/$defs/sha256" },
    "restoration_snapshot_fingerprint": { "$ref": "#/$defs/sha256" },
    "authorized_actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["query-exact-device", "verify-package", "bind-exact-device", "verify-exact-device", "restore-exact-device", "restart-exact-device"] } },
    "expected_restart_reboot_policy": { "enum": ["none", "exact-device-separate-authorization", "reboot-never-automatic"] },
    "stop_conditions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "plan_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "instanceId": { "type": "string", "minLength": 5, "maxLength": 512, "pattern": "^[A-Za-z0-9_&\\\\#{}().,+:;=@%!\\-]+$" },
    "stringArray": { "type": "array", "items": { "type": "string" } },
    "driverIdentity": {
      "type": "object",
      "required": ["canonical_inf_path", "package_byte_size", "published_inf", "original_inf", "provider", "description", "driver_version", "driver_date", "signer", "catalog_identity", "service", "driver_key", "matching_id", "driver_rank", "driver_node_id", "inf_sha256", "catalog_sha256", "architecture", "model_id", "install_section"],
      "properties": {
        "canonical_inf_path": { "type": "string", "minLength": 3 },
        "package_byte_size": { "type": "integer", "minimum": 1 },
        "published_inf": { "type": "string", "minLength": 1 },
        "original_inf": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "driver_version": { "type": "string", "minLength": 1 },
        "driver_date": { "type": "string", "minLength": 1 },
        "signer": { "type": "string", "minLength": 1 },
        "catalog_identity": { "type": "string", "minLength": 1 },
        "service": { "type": "string", "minLength": 1 },
        "driver_key": { "type": "string", "minLength": 1 },
        "matching_id": { "type": "string", "minLength": 1 },
        "driver_rank": { "type": "integer", "minimum": 0 },
        "driver_node_id": { "type": "string", "minLength": 1 },
        "inf_sha256": { "$ref": "#/$defs/sha256" },
        "catalog_sha256": { "$ref": "#/$defs/sha256" },
        "architecture": { "type": "string", "minLength": 1 },
        "model_id": { "type": "string", "minLength": 1 },
        "install_section": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "restorationSnapshot": {
      "type": "object",
      "required": ["schema_id", "canonical_json_version", "canonical_instance_id", "class_guid", "container_id", "parent_instance_id", "location_paths", "hardware_ids", "compatible_ids", "device_status", "problem_code", "restart_required", "reboot_required", "driver_identity", "snapshot_timestamp", "unavailable_properties", "snapshot_sha256"],
      "properties": {
        "schema_id": { "const": "chatpad-exact-instance-restoration-snapshot-v1" },
        "canonical_json_version": { "const": "chatpad-canonical-json-v1" },
        "canonical_instance_id": { "$ref": "#/$defs/instanceId" },
        "class_guid": { "type": "string", "format": "uuid" },
        "container_id": { "type": "string" },
        "parent_instance_id": { "type": "string" },
        "location_paths": { "$ref": "#/$defs/stringArray" },
        "hardware_ids": { "$ref": "#/$defs/stringArray" },
        "compatible_ids": { "$ref": "#/$defs/stringArray" },
        "device_status": { "type": "string", "minLength": 1 },
        "problem_code": { "type": "integer", "minimum": 0 },
        "restart_required": { "type": "boolean" },
        "reboot_required": { "type": "boolean" },
        "driver_identity": { "$ref": "#/$defs/driverIdentity" },
        "snapshot_timestamp": { "type": "string", "format": "date-time" },
        "unavailable_properties": { "$ref": "#/$defs/stringArray" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
