{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatpad-super-driver.invalid/schemas/exact-instance-operation-plan-v1.json",
  "title": "Chatpad exact-instance operation plan",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "operation_id",
    "operation_type",
    "generated_utc",
    "expires_utc",
    "repository_branch",
    "implementation_commit",
    "host_identity",
    "session_identity",
    "authorization_context",
    "requested_instance_id",
    "canonical_instance_id",
    "device_class_guid",
    "current_driver_identity",
    "target_driver_identity",
    "expected_post_bind_driver_identity",
    "restoration_snapshot",
    "exact_restoration_driver_identity",
    "precondition_fingerprint",
    "restoration_snapshot_fingerprint",
    "authorized_actions",
    "stop_conditions",
    "plan_sha256"
  ],
  "properties": {
    "schema_id": { "const": "chatpad-exact-instance-operation-plan-v1" },
    "schema_version": { "const": 1 },
    "operation_id": { "type": "string", "format": "uuid" },
    "operation_type": { "enum": ["bind", "restore"] },
    "generated_utc": { "type": "string", "format": "date-time" },
    "expires_utc": { "type": "string", "format": "date-time" },
    "repository_branch": { "type": "string", "minLength": 1 },
    "implementation_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "host_identity": { "type": "string", "minLength": 1 },
    "session_identity": { "type": "string", "minLength": 1 },
    "authorization_context": { "type": "object" },
    "requested_instance_id": { "type": "string", "minLength": 5, "maxLength": 512 },
    "canonical_instance_id": { "type": "string", "minLength": 5, "maxLength": 512 },
    "device_class_guid": { "type": "string", "format": "uuid" },
    "container_id": { "type": "string" },
    "parent_instance_id": { "type": "string" },
    "location_paths": { "type": "array", "items": { "type": "string" } },
    "hardware_ids": { "type": "array", "items": { "type": "string" } },
    "compatible_ids": { "type": "array", "items": { "type": "string" } },
    "current_driver_identity": { "$ref": "#/$defs/driverIdentity" },
    "target_driver_identity": { "$ref": "#/$defs/driverIdentity" },
    "expected_post_bind_driver_identity": { "$ref": "#/$defs/driverIdentity" },
    "exact_restoration_driver_identity": { "$ref": "#/$defs/driverIdentity" },
    "restoration_snapshot": { "type": "object" },
    "precondition_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "restoration_snapshot_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authorized_actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "stop_conditions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "driverIdentity": {
      "type": "object",
      "required": [
        "canonical_inf_path",
        "package_byte_size",
        "published_inf",
        "provider",
        "driver_version",
        "driver_date",
        "service",
        "driver_key",
        "matching_id",
        "driver_node_id",
        "inf_sha256",
        "catalog_sha256",
        "architecture",
        "model_id",
        "install_section"
      ]
    }
  },
  "additionalProperties": false
}
